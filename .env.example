# RingBreaker Environment Configuration

# Server
PORT=8000
HOST=127.0.0.1
DEBUG=True
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ADMIN_TOKEN=rb_secret_admin_token_change_me

# PayPal Developer Sandbox Credentials
# Strictly sandbox-only; application will refuse production URLs
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# LLM Investigator Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
# Optional OpenAI configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Risk Thresholds (0.0 to 1.0)
# Calibrated operating thresholds from metrics.json
THRESHOLD_LOW_CAPTURE=0.40
THRESHOLD_HIGH_VOID=0.60

# SQLite Database Path
DATABASE_PATH=ringbreaker.db
